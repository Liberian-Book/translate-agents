{
  "name": "bot-reader-website",
  "version": "1.0.0",
  "private": true,
  "description": "Bilingual book reader website",
  "scripts": {
    "build": "node ../../scripts/build-site.mjs",
    "dev": "npm run build && npm run dev:built",
    "dev:built": "wrangler pages dev ../../dist/site",
    "start": "npm run dev",
    "deploy": "npm run build && npm run deploy:built",
    "deploy:built": "wrangler pages deploy ../../dist/site --project-name books --branch main --commit-dirty=true"
  }
}
