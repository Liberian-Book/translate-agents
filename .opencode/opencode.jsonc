{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "code-review-graph": {
      "type": "local",
      "command": ["uvx", "code-review-graph", "serve"]
    },
    "deepwiki": {
      "type": "remote",
      "url": "https://mcp.deepwiki.com/mcp"
    },
    "gh_grep": {
      "type": "remote",
      "url": "https://mcp.grep.app"
    }
  },
  "permission": {
    "read": {
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow"
    },
    "bash": {
      "*cat*.env*": "deny",
      "*cat*.env.example*": "allow",
      "*grep*.env*": "deny",
      "*grep*.env.example*": "allow",
      "*head*.env*": "deny",
      "*head*.env.example*": "allow",
      "*tail*.env*": "deny",
      "*tail*.env.example*": "allow",
      "*less*.env*": "deny",
      "*less*.env.example*": "allow",
      "*more*.env*": "deny",
      "*more*.env.example*": "allow"
    }
  },
  "agent": {
    "asm-review-master": {
      "model": "openai/gpt-5.5"
    },
    "asm-review-contracts": {
      "model": "openai/gpt-5.4"
    },
    "asm-review-data-security": {
      "model": "openai/gpt-5.5",
      "reasoningEffort": "high"
    },
    "asm-review-frontend": {
      "model": "openai/gpt-5.4"
    },
    "asm-review-logic": {
      "model": "openai/gpt-5.4"
    },
    "asm-review-performance": {
      "model": "openai/gpt-5.5",
      "reasoningEffort": "high"
    },
    "asm-librarian": {
      "model": "openai/gpt-5.4-mini"
    },
    "asm-knowledge-extract": {
      "model": "openai/gpt-5.4-mini"
    },
    "asm-finder": {
      "model": "openai/gpt-5.4-mini"
    },
    "asm-oracle": {
      "model": "openai/gpt-5.5",
      "reasoningEffort": "high"
    }
  }
}
